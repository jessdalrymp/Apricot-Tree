# Needed on static (Apache/LiteSpeed) hosting like Hostinger Premium, so
# client-side routes (e.g. /shop, /about) load index.html instead of 404ing
# on a direct visit or refresh.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
