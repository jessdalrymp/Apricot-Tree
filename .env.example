# Printify — Account Settings → Connections → Generate personal access token
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=

# Stripe — used by the checkout API route to collect payment before an order is sent to Printify
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# Shown in the site footer / share buttons — fill in once each account exists.
# Instagram is already confirmed live (found via the shop's follow QR code);
# the rest are placeholders — swap in the real URL once each account is created.
VITE_PINTEREST_URL=https://pinterest.com/apricot_tree_stationery
VITE_INSTAGRAM_URL=https://instagram.com/apricot_tree_stationery
VITE_TIKTOK_URL=https://tiktok.com/@apricot_tree_stationery
VITE_YOUTUBE_URL=https://youtube.com/@apricot_tree_stationery
